# 값을 바꾸지 않으면 코드 기본값(docker-compose 로컬 PostgreSQL)이 사용된다
LOG_LEVEL=INFO

# 서비스 식별 (구조적 로깅) — 배포 시 env로 주입
SERVICE_NAME=reco
SERVICE_VERSION=0.1.0
ENV=local

# 구좌별 라우터 on/off — 로컬은 전 지면 켜서 모놀리스로 실행.
# gitops에선 지면마다 하나만 켠 Deployment로 나눠 독립 스케일.
ENABLE_RELATED=true
ENABLE_PERSONALIZED=true
ENABLE_POPULAR=true

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=reco
PG_PASSWORD=reco
PG_DB=reco
